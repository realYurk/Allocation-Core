{
  "schema": "allocation-ir/2.0",
  "name": "制造业两步分摊：工厂→系列→商品（合成数据）",
  "precision": 2,
  "dimensions": [
    "period",
    "plant",
    "brand",
    "family",
    "sku",
    "account",
    "currency"
  ],
  "immutable_dimensions": [
    "period",
    "currency"
  ],
  "hierarchies": {},
  "datasets": {
    "amounts": {
      "expenses": "amounts.csv"
    },
    "drivers": {
      "labor": "labor.csv",
      "sales": "sales.csv"
    }
  },
  "stages": [
    {
      "id": "第一步_工厂分到系列",
      "inputs": [
        {
          "from": "expenses",
          "share": "1"
        }
      ],
      "source": {
        "grouping": {
          "period": "AS_IS",
          "plant": "AS_IS",
          "brand": "TOTAL",
          "family": "TOTAL",
          "sku": "TOTAL",
          "account": "AS_IS",
          "currency": "AS_IS"
        },
        "filters": {}
      },
      "target": {
        "period": {
          "mode": "SOURCE"
        },
        "plant": {
          "mode": "SOURCE"
        },
        "brand": {
          "mode": "ELEMENT",
          "value": "品牌甲"
        },
        "family": {
          "mode": "INCLUDE",
          "include": [
            "系列甲",
            "系列乙"
          ]
        },
        "sku": {
          "mode": "ELEMENT",
          "value": "Unassigned"
        },
        "account": {
          "mode": "SOURCE"
        },
        "currency": {
          "mode": "SOURCE"
        }
      },
      "conservation_keys": [
        "plant",
        "account",
        "period",
        "currency"
      ],
      "allocations": [
        {
          "id": "hours",
          "share": "1",
          "driver_dataset": "labor",
          "weight_field": "hours",
          "negative_driver_policy": "REJECT"
        }
      ]
    },
    {
      "id": "第二步_系列分到商品",
      "inputs": [
        {
          "from": "第一步_工厂分到系列",
          "share": "1"
        }
      ],
      "source": {
        "grouping": {
          "period": "AS_IS",
          "plant": "AS_IS",
          "brand": "AS_IS",
          "family": "AS_IS",
          "sku": "TOTAL",
          "account": "AS_IS",
          "currency": "AS_IS"
        },
        "filters": {}
      },
      "target": {
        "period": {
          "mode": "SOURCE"
        },
        "plant": {
          "mode": "SOURCE"
        },
        "brand": {
          "mode": "SOURCE"
        },
        "family": {
          "mode": "SOURCE"
        },
        "sku": {
          "mode": "INCLUDE",
          "include": [
            "Item-A",
            "Item-B",
            "商品C",
            "商品D"
          ]
        },
        "account": {
          "mode": "SOURCE"
        },
        "currency": {
          "mode": "SOURCE"
        }
      },
      "conservation_keys": [
        "plant",
        "account",
        "period",
        "currency",
        "family"
      ],
      "allocations": [
        {
          "id": "units",
          "share": "1",
          "driver_dataset": "sales",
          "weight_field": "units",
          "negative_driver_policy": "REJECT"
        }
      ]
    }
  ]
}