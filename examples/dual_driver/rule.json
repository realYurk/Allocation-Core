{
  "schema": "allocation-ir/2.0",
  "name": "双因子费用分摊｜材料75% + 收入25%",
  "precision": 2,
  "dimensions": [
    "period",
    "department",
    "sku",
    "account",
    "currency"
  ],
  "immutable_dimensions": [
    "period",
    "currency"
  ],
  "hierarchies": {},
  "datasets": {
    "amounts": {
      "expenses": "amounts.csv"
    },
    "drivers": {
      "material": "material.csv",
      "revenue": "revenue.csv"
    }
  },
  "stages": [
    {
      "id": "双因子分摊",
      "inputs": [
        {
          "from": "expenses",
          "share": "1"
        }
      ],
      "source": {
        "grouping": {
          "period": "AS_IS",
          "department": "AS_IS",
          "sku": "TOTAL",
          "account": "AS_IS",
          "currency": "AS_IS"
        },
        "filters": {}
      },
      "target": {
        "period": {
          "mode": "SOURCE"
        },
        "department": {
          "mode": "SOURCE"
        },
        "sku": {
          "mode": "INCLUDE",
          "include": [
            "Item-A",
            "Item-B"
          ]
        },
        "account": {
          "mode": "SOURCE"
        },
        "currency": {
          "mode": "SOURCE"
        }
      },
      "conservation_keys": [
        "period",
        "account",
        "currency",
        "department"
      ],
      "allocations": [
        {
          "id": "material",
          "share": "0.75",
          "driver_dataset": "material",
          "weight_field": "material",
          "negative_driver_policy": "REJECT"
        },
        {
          "id": "revenue",
          "share": "0.25",
          "driver_dataset": "revenue",
          "weight_field": "revenue",
          "negative_driver_policy": "REJECT"
        }
      ]
    }
  ]
}
