  "incremental_recalculation": false,
  "approval_module": false,
  "distribution_identity": "RELEASE_IDENTITY.json",
  "sdk_http_files": [
    "results.csv",
    "ledger.csv",
    "ledger.csv.gz",
    "reconciliation.csv",
    "source_to_pool.csv",
    "source_to_pool.csv.gz",
    "lineage_links.csv",
    "lineage_links.csv.gz",
    "evidence_stream_manifest.json",
    "run_summary.json"
  ],
  "integration_safety_tools": [
    "integration/tools/capacity_preflight.py",
    "integration/tools/capture_replay_inputs.py",
    "integration/tools/release_info.py"
  ],
  "capacity_budget_is_hard_runtime_quota": false,
  "vault_includes_inputs": false
}
